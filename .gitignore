# 运行时生成的数据库与上传目录
/db/
/upload/
*.db
*.db-shm
*.db-wal

# 编译产物
/webstack
/webstack.exe
/dist/

# 本地配置（可能包含数据库密码等敏感信息）
/config.local.json

# Docker 部署时的运行时数据与实际配置文件
# 仅忽略 docker/webstack 目录下的 config.json，
# 项目根目录的 config.json 仍需纳入版本管理
/docker/webstack/data/
/docker/webstack/config.json

# IDE 配置
/.idea/
/.vscode/
*.iml
