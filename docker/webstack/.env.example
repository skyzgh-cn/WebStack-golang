# 复制为 .env 后填入实际值。.env 已被 .gitignore 排除，不会进入版本库。

# 镜像版本，发布新版本后改为对应标签（如 v2.1.1），留空则使用 latest
WEBSTACK_VERSION=v2.1.1

# MySQL 连接信息
MYSQL_USER=webstack
MYSQL_PASSWORD=
MYSQL_DATABASE=webstack

# 站点通过 HTTPS 访问时设为 true
WEBSTACK_SECURE_COOKIE=false

# 可信反向代理地址，多个用英文逗号分隔。
# 使用 host 网络部署时，宿主机上的 Nginx 代理来源为 127.0.0.1
WEBSTACK_TRUSTED_PROXIES=127.0.0.1
